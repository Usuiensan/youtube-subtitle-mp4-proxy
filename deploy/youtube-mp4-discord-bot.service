[Unit]
Description=YouTube MP4 Discord bot
After=network-online.target youtube-mp4-proxy.service
Wants=network-online.target

[Service]
User=app
Group=app
WorkingDirectory=/opt/youtube-mp4-proxy
EnvironmentFile=/etc/youtube-mp4-proxy/config.env
EnvironmentFile=/etc/youtube-mp4-proxy/secrets.env
ExecStart=/opt/youtube-mp4-proxy/.venv/bin/python -m bot.main
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
