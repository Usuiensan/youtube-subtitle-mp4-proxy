#!/bin/bash
set -Eeuo pipefail

APP_DIR="/opt/youtube-mp4-proxy"
PROXY_SERVICE="youtube-mp4-proxy"
DISCORD_SERVICE="youtube-mp4-discord-bot"
INCOMING_DIR="/var/lib/youtube-proxy/incoming"
ARCHIVE=""

usage() { echo "Usage: $0 --archive /tmp/youtube-proxy-<git-sha>.tar.gz"; exit 2; }
while (($#)); do
    case "$1" in
        --archive) [[ $# -ge 2 ]] || usage; ARCHIVE="$2"; shift 2;;
        *) usage;;
    esac
done
[[ "$ARCHIVE" =~ ^/tmp/youtube-proxy-[0-9a-f]{40}\.tar\.gz$ ]] || { echo "アーカイブパスが不正です"; exit 1; }
[[ -f "$ARCHIVE" && ! -L "$ARCHIVE" ]] || { echo "アーカイブが見つかりません"; exit 1; }
[[ $(id -u) -eq 0 ]] || { echo "root権限で実行してください"; exit 1; }
[[ -x "$APP_DIR/.venv/bin/python" ]] || { echo "Python仮想環境が見つかりません"; exit 1; }

TS=$(date +%Y%m%d-%H%M%S)
STAGE=$(mktemp -d "/tmp/youtube-proxy-release-$TS.XXXXXX")
BACKUP="$APP_DIR.rollback-$TS"
SAFE_ARCHIVE="$INCOMING_DIR/$(basename "$ARCHIVE")"
mkdir -p "$INCOMING_DIR"
chmod 700 "$INCOMING_DIR"
install -o root -g root -m 600 "$ARCHIVE" "$SAFE_ARCHIVE"
rm -f -- "$ARCHIVE"
while IFS= read -r entry; do
    [[ "$entry" != /* && "$entry" != ../* && "$entry" != */../* && "$entry" != */.. && "$entry" != ".." && "$entry" != *$'\n'* ]] || { echo "アーカイブ内パスが不正です"; exit 1; }
done < <(tar -tzf "$SAFE_ARCHIVE")
tar -xzf "$SAFE_ARCHIVE" --no-same-owner --no-same-permissions -C "$STAGE"
if find "$STAGE" -type l -print -quit | grep -q .; then
    echo "アーカイブ内のシンボリックリンクは禁止です"
    exit 1
fi
"$APP_DIR/.venv/bin/python" -m compileall -q "$STAGE/app" "$STAGE/bot"
grep -q 'silent=True' "$STAGE/bot/main.py"
"$APP_DIR/.venv/bin/python" -m pip install -r "$STAGE/requirements.txt"

mkdir -p "$BACKUP"
rsync -a --delete \
    --exclude='.venv/' \
    --exclude='.env*' \
    --exclude='.pytest_cache/' \
    --exclude='cache/' \
    --exclude='data/' \
    "$APP_DIR/" "$BACKUP/"
systemctl stop "$DISCORD_SERVICE" "$PROXY_SERVICE"
rsync -a --delete --exclude='.venv/' --exclude='.env*' --exclude='.pytest_cache/' --exclude='cache/' --exclude='data/' --exclude='.translation-audit/' --exclude='.translation-attempts/' "$STAGE/" "$APP_DIR/"
install -o root -g root -m 755 "$STAGE/scripts/youtube-proxy-update" /usr/local/sbin/youtube-proxy-update
install -o root -g root -m 755 "$STAGE/scripts/youtube-proxy-audit" /usr/local/sbin/youtube-proxy-audit
install -o root -g root -m 755 "$STAGE/scripts/youtube-proxy-config" /usr/local/sbin/youtube-proxy-config
install -o root -g root -m 755 "$STAGE/scripts/youtube-proxy-operator" /usr/local/sbin/youtube-proxy-operator
install -o root -g root -m 644 "$STAGE/deploy/youtube-proxy-storage-watch.service" /etc/systemd/system/youtube-proxy-storage-watch.service
install -o root -g root -m 440 "$STAGE/deploy/youtube-proxy-sudoers" /etc/sudoers.d/youtube-proxy-deploy.new
visudo -cf /etc/sudoers.d/youtube-proxy-deploy.new >/dev/null
install -o root -g root -m 440 /etc/sudoers.d/youtube-proxy-deploy.new /etc/sudoers.d/youtube-proxy-deploy
rm -f /etc/sudoers.d/youtube-proxy-deploy.new
systemctl daemon-reload
systemctl enable --now youtube-proxy-storage-watch.service
systemctl start "$PROXY_SERVICE"
systemctl start "$DISCORD_SERVICE"
sleep 5
systemctl is-active --quiet "$PROXY_SERVICE"
systemctl is-active --quiet "$DISCORD_SERVICE"
curl --fail --silent --show-error http://127.0.0.1:8000/healthz
echo "更新完了: $TS (切り戻し先: $BACKUP)"
